<Project Sdk="Microsoft.NET.Sdk">

  <!-- General build settings: defines the output type and target framework -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- C# language features and debugging configuration -->
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Packaging and publish configuration -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>true</IsTestProject>
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>

  <!-- Test configuration -->
  <PropertyGroup>
    <!-- Multi-target tests and all generated reports are isolated per TFM. -->
    <TestTfmsInParallel>true</TestTfmsInParallel>
    <_MSTestResultsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'MSTestResults'))</_MSTestResultsDir>
    <VSTestLogger>trx%3bLogFileName=$(_MSTestResultsDir)$(MSBuildProjectName)-$(TargetFramework).trx;html%3bLogFileName=$(_MSTestResultsDir)result-$(TargetFramework).html</VSTestLogger>
  </PropertyGroup>

  <!-- coverlet.msbuild: CollectCoverage is enough for `dotnet test` on SDK MSBuild. -->
  <!-- Include is the packable library only (sourceName). Threshold fails the test run when that assembly is under 100% line/branch/method total. -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>opencover,json</CoverletOutputFormat>
    <CoverletOutput>./CoverletOutput/</CoverletOutput>
    <Include>[Eigenverft.WebLib.SerilogRelayReceiver]*</Include>
    <Threshold>100</Threshold>
    <ThresholdType>line,branch,method</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>


  <!-- Package inventory of the packable library, not this test project. -->
  <PropertyGroup>
    <NugetReportDir Condition=" '$(NugetReportDir)' == '' ">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'NugetReport'))</NugetReportDir>
    <NugetReportProject Condition=" '$(NugetReportProject)' == '' ">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'Eigenverft.WebLib.SerilogRelayReceiver', 'Eigenverft.WebLib.SerilogRelayReceiver.csproj'))</NugetReportProject>
  </PropertyGroup>
  <Target Name="WriteNugetReport" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <_NugetReportPrefix>$(NugetReportDir)$([System.IO.Path]::GetFileNameWithoutExtension('$(NugetReportProject)'))</_NugetReportPrefix>
    </PropertyGroup>
    <MakeDir Directories="$(NugetReportDir)" />
    <Exec Command="dotnet list &quot;$(NugetReportProject)&quot; package %3E &quot;$(_NugetReportPrefix)-packages.txt&quot;" IgnoreExitCode="true" />
    <Exec Command="dotnet list &quot;$(NugetReportProject)&quot; package --format json %3E &quot;$(_NugetReportPrefix)-packages.json&quot;" IgnoreExitCode="true" />
    <Exec Command="dotnet list &quot;$(NugetReportProject)&quot; package --include-transitive --vulnerable %3E &quot;$(_NugetReportPrefix)-vulnerable.txt&quot;" IgnoreExitCode="true" />
    <Exec Command="dotnet list &quot;$(NugetReportProject)&quot; package --include-transitive --vulnerable --format json %3E &quot;$(_NugetReportPrefix)-vulnerable.json&quot;" IgnoreExitCode="true" />
  </Target>



  <!-- Keep Git configuration on disk without showing it as a project item -->
  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>

  <!-- Keep both test TFMs and reference the matching Eigenverft.WebLib.SerilogRelayReceiver TFM for each test build. -->
  <ItemGroup>
    <ProjectReference Include="..\Eigenverft.WebLib.SerilogRelayReceiver\Eigenverft.WebLib.SerilogRelayReceiver.csproj">
      <SetTargetFramework>TargetFramework=$(TargetFramework)</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <!-- External dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
