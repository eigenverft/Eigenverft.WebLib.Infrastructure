<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />
  <!-- Keep global analyzer scoped to the project directory config file on disk without showing it as a project item. -->
  <!-- EnforceCodeStyleInBuild is required or IDE1006 stays IDE-only and `dotnet build` ignores the file. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildProjectDirectory)\.project.editor.globalconfig" Visible="false" />
  </ItemGroup>

  <!-- General build settings: defines the output type and target framework -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Packaging and publish configuration -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <PublishRelease>true</PublishRelease>
    <IsTestProject>false</IsTestProject>
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>

  <!-- C# language features and debugging configuration -->
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Keep Git configuration on disk without showing it as a project item -->
  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>

  <!-- Versioning -->
  <PropertyGroup>
    <GitVersionBaseDirectory>$(MSBuildProjectDirectory)\Properties\</GitVersionBaseDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Package metadata -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Eigenverft.WebLib.Hosting.DirectoryLayout</PackageId>
    <Authors>Eigenverft</Authors>
    <Owners>Eigenverft</Owners>
    <RepositoryUrl>https://github.com/eigenverft/Eigenverft.WebLib.Infrastructure</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/eigenverft/Eigenverft.WebLib.Infrastructure</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <PackageIcon>Icon-128x128.png</PackageIcon>
    <Description>Executable-rooted application directory layout and WebApplicationBuilder environment helpers for ASP.NET Core hosting.</Description>
    <PackageTags>dotnet;aspnet-core;hosting;directories;filesystem;eigenverft</PackageTags>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)\NugetAssets\ReleaseNotes.txt"))</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Package specs -->

  <!-- Capability and external dependencies -->
  <ItemGroup>
    <PackageReference Include="Eigenverft.NetLib.Hosting.DirectoryLayout" Version="1.0.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)\NugetAssets\**\*" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup>
    <PackageOutputPath Condition=" '$(PackageOutputPath)' == '' ">$(MSBuildProjectDirectory)\bin\Pack</PackageOutputPath>
  </PropertyGroup>

  <!-- Publish behavior keep slim for library specs -->
	<PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
		<!-- Flat publish output -->
		<PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)\bin\Publish\</PublishDir>
		<PublishAot>false</PublishAot>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

  <!-- Publish behavior for executable future useage program main etc -->
	<PropertyGroup Condition="'$(_IsPublishing)' == 'true' and '$(OutputType)' != 'Library'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishSelfContained>true</PublishSelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>


  <!-- Import for version information already integrated in < net8.0 -->
  <Import Project="Build/SourceControlState.targets" />
  <Import Project="Build/ImportSdkTargets.targets" />

</Project>
