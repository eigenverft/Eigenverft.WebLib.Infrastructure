<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />

  <!-- General build settings: defines the output type and target framework -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- C# language features and debugging configuration -->
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- XML documentation file -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- GlobalAnalyzerConfigFiles is what Roslyn reads. Visible=false so VS does not show that item twice. -->
  <!-- None+Link is Solution Explorer only. Disk path stays next to the csproj: Properties/ would change analyzer scope. -->
  <!-- EnforceCodeStyleInBuild is required or IDE1006 stays IDE-only and `dotnet build` ignores the file. -->
  <!-- OptimizeImplicitlyTriggeredBuild=false: VS Test Explorer / F5 must not skip analyzers (dotnet test does not). -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <OptimizeImplicitlyTriggeredBuild>false</OptimizeImplicitlyTriggeredBuild>
  </PropertyGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildProjectDirectory)\.project.editor.globalconfig" Visible="false" />
    <None Remove=".project.editor.globalconfig" />
    <None Include=".project.editor.globalconfig" Link="Properties\.project.editor.globalconfig" />
  </ItemGroup>

  <!-- SDK CA rule set. Always written; omitted AnalysisMode switch means Recommended. -->
  <PropertyGroup>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <!-- Restore NuGetAudit is already on. High (NU1903) and critical (NU1904) fail restore. Low/moderate stay warnings. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Packaging and publish configuration -->
  <!-- EnablePackageValidation: TFM/runtime holes on pack. No baseline at generate; set PackageValidationBaselineVersion after the first nuget.org publish. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <PublishRelease>true</PublishRelease>
    <IsTestProject>false</IsTestProject>
    <PackAsTool>false</PackAsTool>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- SDK defaults stay. CheckEol: true for exe, skipped for Library. InvariantGlobalization unset = cultures on. -->
  <PropertyGroup>
    <CheckEolTargetFramework>$(CheckEolTargetFramework)</CheckEolTargetFramework>
    <InvariantGlobalization>$(InvariantGlobalization)</InvariantGlobalization>
  </PropertyGroup>

  <!-- Versioning: Nerdbank -->
  <PropertyGroup>
    <GitVersionBaseDirectory>$(MSBuildProjectDirectory)\Properties</GitVersionBaseDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- EF Core is the built-in durable persistence integration. The concrete provider remains host-owned. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <!-- Package metadata -->
  <!-- https://learn.microsoft.com/en-us/nuget/create-packages/package-authoring-best-practices -->
  <PropertyGroup>
    <Authors>Eigenverft</Authors>
    <Owners>Eigenverft</Owners>
    <PackageId>Eigenverft.WebLib.SerilogRelayReceiver</PackageId>
    <PackageTags>dotnet;aspnet-core;web;logging;serilog;relay;receiver;entity-framework-core;ef-core;eigenverft</PackageTags>
    <PackageProjectUrl>https://github.com/eigenverft/Eigenverft.WebLib.Infrastructure</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eigenverft/Eigenverft.WebLib.Infrastructure</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- NuGet gallery blurb. CDATA is optional and keeps multiline text. -->
    <Description><![CDATA[ASP.NET Core receiver for Eigenverft SerilogRelay batches with provider-neutral Entity Framework Core persistence and custom handler support.]]></Description>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Icon-128x128.png</PackageIcon>
    <!-- Read multiline release notes from a separate source file so this project file stays compact. -->
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)\Properties\NugetMetadata\PackageReleaseNotes.txt"))</PackageReleaseNotes>
  </PropertyGroup>

  <!-- NuGet package metadata from Properties/NugetMetadata is packed as package content. PackageReleaseNotes.txt is consumed for PackageReleaseNotes and is not packed as a loose file. -->
  <!-- Standard licenses use PackageLicenseExpression and create no License.txt. -->
  <!-- Custom: pack License.txt as PackageLicenseFile. PackagePath empty: nupkg root / docs/, not Properties/. -->
  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)\Properties\NugetMetadata\**\*" Pack="true" PackagePath="" Exclude="$(MSBuildProjectDirectory)\Properties\NugetMetadata\License.txt;$(MSBuildProjectDirectory)\Properties\NugetMetadata\PackageReleaseNotes.txt" />
  </ItemGroup>

  <PropertyGroup>
    <PackageOutputPath Condition=" '$(PackageOutputPath)' == '' ">$(MSBuildProjectDirectory)\bin\Pack</PackageOutputPath>
  </PropertyGroup>

  <!-- Publish behavior keep slim for library specs -->
	<PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
		<!-- Flat publish output -->
		<PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)\bin\Publish\</PublishDir>
		<PublishAot>false</PublishAot>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

  <!-- Executable-only publish settings remain inactive while this project is a library. -->
	<PropertyGroup Condition="'$(_IsPublishing)' == 'true' and '$(OutputType)' != 'Library'">
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishSelfContained>true</PublishSelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>


  <!-- Keep Git configuration on disk without showing it as a project item -->
  <ItemGroup>
    <None Remove=".gitignore" />
  </ItemGroup>


  <!-- Source Link git state as properties (SDK 8+). Target hooks GenerateAssemblyInfo. -->
  <Import Project="Properties/Build/SourceControlState.targets" />
  <!--
    Must stay last. This import is Sdk.targets plus the outer Publish dispatch.
    The SDK reads properties and items while it loads (EnforceCodeStyleInBuild,
    GlobalAnalyzerConfigFiles, AnalysisMode, EnablePackageValidation, WarningsAsErrors, publish). Anything after this line is after the
    SDK and is ignored for that. Project Sdk="..." would append Sdk.targets
    after this file and overwrite the Publish override.
  -->
  <Import Project="Properties/Build/ImportSdkTargets.targets" />

</Project>
