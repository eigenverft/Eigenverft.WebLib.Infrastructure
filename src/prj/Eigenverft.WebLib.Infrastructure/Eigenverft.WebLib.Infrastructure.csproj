<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Branding>Eigenverft</Branding>
    <!-- net9.0 consumers use the compatible net8.0 asset; net11.0 remains preview-only. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>false</IsTestProject>
    <VersionBuild>1</VersionBuild>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <VersionRevision>0</VersionRevision>
    <AssemblyVersion>$(VersionBuild).$(VersionMajor).$(VersionMinor).$(VersionRevision)</AssemblyVersion>
    <Version>$(VersionBuild).$(VersionMajor).$(VersionMinor).$(VersionRevision)$(VersionSuffix)</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Branding)</Authors>
    <RepositoryUrl>https://github.com/eigenverft/$(AssemblyName)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/eigenverft/$(AssemblyName)</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>evt-logo_on_all_standard_128x128.png</PackageIcon>
    <PackageReleaseNotes>Adds one-record-per-request traffic logging on ASP.NET Core HTTP Logging, isolated post-Build UseX(Action&lt;TOptions&gt;) option overrides with reload and validation support, and shared NetLib IP normalization in client-network features. Updates Eigenverft.NetLib.Infrastructure to 1.0.20264.61091 and uses the neutral Eigenverft package icon. Existing flood protection, self-HTTP warmup, isolated static/PWA hosting, canonical redirects, typed request features, Kestrel/SNI, and Data Protection helpers remain included.</PackageReleaseNotes>
    <Description>ASP.NET Core infrastructure helpers including web-host directory setup, request-pipeline middleware, typed request features, Data Protection transforms, and Kestrel/SNI configuration.</Description>
    <PackageTags>dotnet;aspnet-core;web;infrastructure;hosting;middleware;kestrel;sni;data-protection;security;eigenverft</PackageTags>
    <Copyright>Copyright (c) 2026 $(Branding)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../README.NUGET.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
    <None Include="AddPackageFiles/evt-logo_on_all_standard_128x128.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Eigenverft.NetLib.Infrastructure" Version="1.0.20264.61091" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
