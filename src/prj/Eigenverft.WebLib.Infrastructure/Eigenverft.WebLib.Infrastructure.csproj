<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Branding>Eigenverft</Branding>
    <!-- net9.0 consumers use the compatible net8.0 asset; net11.0 remains preview-only. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>false</IsTestProject>
    <VersionBuild>1</VersionBuild>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <VersionRevision>0</VersionRevision>
    <AssemblyVersion>$(VersionBuild).$(VersionMajor).$(VersionMinor).$(VersionRevision)</AssemblyVersion>
    <Version>$(VersionBuild).$(VersionMajor).$(VersionMinor).$(VersionRevision)$(VersionSuffix)</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Branding)</Authors>
    <RepositoryUrl>https://github.com/eigenverft/$(AssemblyName)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/eigenverft/$(AssemblyName)</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>eigenverft-logo-v7-harbor-square_128_128.png</PackageIcon>
    <PackageReleaseNotes>Initial public release of the ASP.NET Core hosting, Data Protection, and Kestrel/SNI adapters for Eigenverft.NetLib.Infrastructure.</PackageReleaseNotes>
    <Description>ASP.NET Core adapters for Eigenverft.NetLib.Infrastructure, including web-host directory setup, Data Protection transforms, and Kestrel/SNI configuration.</Description>
    <PackageTags>dotnet;aspnet-core;web;infrastructure;hosting;kestrel;sni;data-protection;security;eigenverft</PackageTags>
    <Copyright>Copyright (c) 2026 $(Branding)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../README.NUGET.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
    <None Include="AddPackageFiles/eigenverft-logo-v7-harbor-square_128_128.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Eigenverft.NetLib.Infrastructure" Version="1.0.20264.56982" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
