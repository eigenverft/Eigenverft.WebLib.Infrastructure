<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Branding>Eigenverft</Branding>
    <!-- net9.0 consumers use the compatible net8.0 asset; net11.0 remains preview-only. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>false</IsTestProject>
    <VersionBuild>1</VersionBuild>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <VersionRevision>0</VersionRevision>
    <AssemblyVersion>$(VersionBuild).$(VersionMajor).$(VersionMinor).$(VersionRevision)</AssemblyVersion>
    <Version>$(VersionBuild).$(VersionMajor).$(VersionMinor).$(VersionRevision)$(VersionSuffix)</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Branding)</Authors>
    <RepositoryUrl>https://github.com/eigenverft/$(AssemblyName)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/eigenverft/$(AssemblyName)</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>evt-logo_on_all_standard_128x128.png</PackageIcon>
    <PackageReleaseNotes>Adds an opt-in server-wide native TokenBucketRateLimiter to FloodProtection, chained after the per-client token bucket and before the preserved optional global concurrency limiter; the shared bucket has explicit burst/rate settings, a bounded OldestFirst queue, framework Retry-After metadata, and remains disabled by default. Adds standard startup configuration for FloodProtection: class defaults are preserved, the FloodProtection configuration section overrides only supplied values, and the optional AddFloodProtection configure delegate is applied last; existing validation remains startup-enforced. Publishes the public CreateUseSiteOptionsMonitor&lt;TOptions&gt; API for isolated middleware use-site overrides. It rebuilds the normal registered options/configuration baseline, runs registered PostConfigure steps, applies the local use-site override afterwards, runs registered validation, supports configuration reload and OnChange, reapplies the local override after reload, and leaves global options unchanged. Also includes one-record-per-request traffic logging on ASP.NET Core HTTP Logging, shared NetLib IP normalization in client-network features, Eigenverft.NetLib.Infrastructure 1.0.20264.61091, and the neutral Eigenverft package icon.</PackageReleaseNotes>
    <Description>ASP.NET Core infrastructure helpers including web-host directory setup, request-pipeline middleware, typed request features, Data Protection transforms, and Kestrel/SNI configuration.</Description>
    <PackageTags>dotnet;aspnet-core;web;infrastructure;hosting;middleware;kestrel;sni;data-protection;security;eigenverft</PackageTags>
    <Copyright>Copyright (c) 2026 $(Branding)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../README.NUGET.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
    <None Include="AddPackageFiles/evt-logo_on_all_standard_128x128.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Eigenverft.NetLib.Infrastructure" Version="1.0.20264.61091" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
